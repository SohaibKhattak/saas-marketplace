{
  "name": "saas-marketplace",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "ccross-env ESLINT_USE_FLAT_CONFIG=false eslint src/",
    "test": "turbo test",
    "db:migrate": "npm run migrate --workspace=apps/api",
    "db:seed": "npm run seed --workspace=apps/api",
    "db:studio": "npm run studio --workspace=apps/api"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "turbo": "^2.4.0"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.103.0"
  }
}