generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  DEVELOPER
  ADMIN
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SiteStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  DELETED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  UNPUBLISHED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum TransactionType {
  PAYMENT
  REFUND
}

enum TransactionStatus {
  SUCCEEDED
  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  fullName      String   @map("full_name")
  role          UserRole @default(CUSTOMER)
  avatarUrl     String?  @map("avatar_url")
  emailVerified Boolean  @default(false) @map("email_verified")
  verifyToken   String?  @map("verify_token")
  resetToken    String?  @map("reset_token")
  resetTokenExp DateTime? @map("reset_token_exp")
  isSuspended   Boolean  @default(false) @map("is_suspended")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  developerProfile DeveloperProfile?
  subscriptions    Subscription[]
  reviews          Review[]
  auditLogs        AuditLog[]
  transactions     Transaction[]     @relation("CustomerTransactions")

  @@map("users")
}

model DeveloperProfile {
  id                String            @id @default(uuid())
  userId            String            @unique @map("user_id")
  businessName      String            @map("business_name")
  businessEmail     String            @map("business_email")
  taxId             String?           @map("tax_id")
  bio               String?
  applicationStatus ApplicationStatus @default(PENDING) @map("application_status")
  rejectionReason   String?           @map("rejection_reason")
  stripeAccountId   String?           @map("stripe_account_id")
  approvedAt        DateTime?         @map("approved_at")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sites        DeveloperSite[]
  products     Product[]
  transactions Transaction[]    @relation("DeveloperTransactions")
  payouts      Payout[]

  @@map("developer_profiles")
}

model DeveloperSite {
  id          String     @id @default(uuid())
  developerId String     @map("developer_id")
  wpSiteId    Int?       @map("wp_site_id")
  subdomain   String     @unique
  siteUrl     String?    @map("site_url")
  status      SiteStatus @default(PROVISIONING)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  developer DeveloperProfile @relation(fields: [developerId], references: [id], onDelete: Cascade)
  products  Product[]

  @@map("developer_sites")
}

model Product {
  id               String        @id @default(uuid())
  developerId      String        @map("developer_id")
  siteId           String?       @map("site_id")
  name             String
  slug             String        @unique
  shortDescription String?       @map("short_description")
  description      String
  category         String
  tags             String[]      @default([])
  logoUrl          String?       @map("logo_url")
  screenshots      String[]      @default([])
  version          String        @default("1.0.0")
  status           ProductStatus @default(DRAFT)
  rejectionReason  String?       @map("rejection_reason")
  isFeatured       Boolean       @default(false) @map("is_featured")
  avgRating        Float         @default(0) @map("avg_rating")
  totalReviews     Int           @default(0) @map("total_reviews")
  totalSubscribers Int           @default(0) @map("total_subscribers")
  publishedAt      DateTime?     @map("published_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  developer    DeveloperProfile @relation(fields: [developerId], references: [id], onDelete: Cascade)
  site         DeveloperSite?   @relation(fields: [siteId], references: [id])
  pricingPlans PricingPlan[]
  subscriptions Subscription[]
  reviews      Review[]

  @@index([category])
  @@index([status])
  @@index([developerId])
  @@map("products")
}

model PricingPlan {
  id                    String  @id @default(uuid())
  productId             String  @map("product_id")
  name                  String
  priceMonthly          Float   @map("price_monthly")
  priceYearly           Float?  @map("price_yearly")
  currency              String  @default("usd")
  features              Json    @default("[]")
  trialDays             Int     @default(0) @map("trial_days")
  isActive              Boolean @default(true) @map("is_active")
  stripePriceIdMonthly  String? @map("stripe_price_id_monthly")
  stripePriceIdYearly   String? @map("stripe_price_id_yearly")
  sortOrder             Int     @default(0) @map("sort_order")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@index([productId])
  @@map("pricing_plans")
}

model Subscription {
  id                   String             @id @default(uuid())
  customerId           String             @map("customer_id")
  productId            String             @map("product_id")
  pricingPlanId        String             @map("pricing_plan_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  status               SubscriptionStatus @default(ACTIVE)
  billingCycle         BillingCycle       @default(MONTHLY) @map("billing_cycle")
  currentPeriodStart   DateTime?          @map("current_period_start")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  trialEnd             DateTime?          @map("trial_end")
  canceledAt           DateTime?          @map("canceled_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  customer    User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product     Product       @relation(fields: [productId], references: [id])
  pricingPlan PricingPlan   @relation(fields: [pricingPlanId], references: [id])
  transactions Transaction[]

  @@index([customerId])
  @@index([productId])
  @@index([status])
  @@map("subscriptions")
}

model Transaction {
  id                    String            @id @default(uuid())
  subscriptionId        String?           @map("subscription_id")
  customerId            String            @map("customer_id")
  developerId           String            @map("developer_id")
  stripePaymentIntentId String?           @map("stripe_payment_intent_id")
  amount                Float
  currency              String            @default("usd")
  platformFee           Float             @map("platform_fee")
  developerAmount       Float             @map("developer_amount")
  status                TransactionStatus @default(SUCCEEDED)
  type                  TransactionType   @default(PAYMENT)
  createdAt             DateTime          @default(now()) @map("created_at")

  subscription Subscription?    @relation(fields: [subscriptionId], references: [id])
  customer     User             @relation("CustomerTransactions", fields: [customerId], references: [id])
  developer    DeveloperProfile @relation("DeveloperTransactions", fields: [developerId], references: [id])

  @@index([customerId])
  @@index([developerId])
  @@index([createdAt])
  @@map("transactions")
}

model Payout {
  id               String       @id @default(uuid())
  developerId      String       @map("developer_id")
  amount           Float
  currency         String       @default("usd")
  status           PayoutStatus @default(PENDING)
  stripeTransferId String?      @map("stripe_transfer_id")
  periodStart      DateTime     @map("period_start")
  periodEnd        DateTime     @map("period_end")
  processedAt      DateTime?    @map("processed_at")
  createdAt        DateTime     @default(now()) @map("created_at")

  developer DeveloperProfile @relation(fields: [developerId], references: [id])

  @@index([developerId])
  @@index([status])
  @@map("payouts")
}

model Review {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  customerId String  @map("customer_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer User    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([productId, customerId])
  @@map("reviews")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  details    Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}
