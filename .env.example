# ─── Backend API ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# JWT Secrets (generate with: openssl rand -base64 48)
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-long-here
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-long-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Email (Resend)
RESEND_API_KEY=re_...

# Supabase
SUPABASE_URL=https://[YOUR-PROJECT].supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# WordPress Multisite
WP_CLI_PATH=/usr/local/bin/wp
WP_SITE_URL=https://your-domain.com

# Frontend
FRONTEND_URL=http://localhost:3000

# Platform Configuration
PLATFORM_FEE_PERCENT=15
MIN_PAYOUT_AMOUNT=50

# ─── Frontend (Next.js) ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_APP_NAME=SaaS Marketplace
